{
  "name": "zini",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "webapp"
  ],
  "scripts": {
    "dev": "concurrently -n backend,webapp -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w webapp\"",
