@@ -0,0 +1,12 @@
+import assert from "node:assert/strict";
+import { serviceClients, todoServiceStats } from "./services.mjs";
+const { db, cache } = await serviceClients();
+try {
+  await cache.del("todo-service:stats");
+  const expected = (await db.query("SELECT count(*)::int AS total, count(*) FILTER (WHERE NOT done)::int AS remaining FROM service_todos")).rows[0];
+  const initial = await todoServiceStats(db, cache);
+  assert.deepEqual(initial.stats, expected); assert.equal(initial.source, "database");
+  const cached = await todoServiceStats(db, cache);
+  assert.deepEqual(cached.stats, expected); assert.equal(cached.source, "cache");
+  console.log("PostgreSQL-backed remaining count and Redis cache passed");
+} finally { await cache.del("todo-service:stats"); await db.end(); await cache.quit(); }
