@@ -0,0 +1,36 @@
+import pg from "pg";
+import { createClient } from "redis";
+export async function serviceClients() {
+  if (!process.env.DATABASE_URL || !process.env.REDIS_URL) throw new Error("DATABASE_URL and REDIS_URL are required; use isolated local test services");
+  const db = new pg.Client({ connectionString: process.env.DATABASE_URL });
+  const cache = createClient({ url: process.env.REDIS_URL });
+  cache.on("error", error => console.error(error.message));
+  await db.connect(); await cache.connect(); return { db, cache };
+}
+export async function todoServiceStats(db, cache) {
+  const stored = await cache.get("todo-service:stats");
+  if (stored) return { stats: JSON.parse(stored), source: "cache" };
+  const result = await db.query("SELECT count(*)::int AS total, count(*) FILTER (WHERE done = true)::int AS remaining FROM service_todos");
+  const stats = result.rows[0];
+  await cache.set("todo-service:stats", JSON.stringify(stats), { EX: 60 });
+  return { stats, source: "database" };
+}
+export async function installServiceRoutes(app) {
+  const { db, cache } = await serviceClients();
+  await db.query("SELECT 1 FROM service_todos LIMIT 1");
+  if (await cache.get("todo-service:seeded") !== "ready") throw new Error("Run services:seed before startup");
+  app.get("/api/service-health", async (_req, res) => {
+    await db.query("SELECT 1"); if (await cache.ping() !== "PONG") throw new Error("Redis unavailable");
+    res.json({ postgres: "ready", redis: "ready" });
+  });
+  app.get("/api/shared-todos", async (_req, res) => res.json((await db.query("SELECT * FROM service_todos ORDER BY id")).rows));
+  app.get("/api/shared-todos/stats", async (_req, res) => {
+    const { stats, source } = await todoServiceStats(db, cache); res.set("X-Stats-Source", source).json(stats);
+  });
+  app.patch("/api/shared-todos/:id", async (req, res) => {
+    if (typeof req.body.done !== "boolean") return res.status(400).json({ error: "done must be boolean" });
+    const updated = await db.query("UPDATE service_todos SET done=$1 WHERE id=$2 RETURNING *", [req.body.done, req.params.id]);
+    if (!updated.rowCount) return res.sendStatus(404);
+    await cache.del("todo-service:stats"); res.json(updated.rows[0]);
+  });
+}
