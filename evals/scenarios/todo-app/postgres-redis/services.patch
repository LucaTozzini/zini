+++ b/server/serviceSetup.mjs
@@ -0,0 +1,17 @@
+import pg from "pg";
+import { createClient } from "redis";
+const db = new pg.Client({ connectionString: process.env.DATABASE_URL });
+const cache = createClient({ url: process.env.REDIS_URL });
+cache.on("error", error => console.error(error.message));
+await db.connect(); await cache.connect();
+try {
+  const command = process.argv[2];
+  if (command === "migrate") await db.query("CREATE TABLE IF NOT EXISTS service_todos (id text primary key, title text not null, done boolean not null default false)");
+  else if (command === "seed") {
+    await db.query("INSERT INTO service_todos(id,title,done) VALUES ('seed-a','Service fixture A',false),('seed-b','Service fixture B',false),('seed-c','Service fixture C',true) ON CONFLICT (id) DO NOTHING");
+    await cache.del("todo-service:stats"); await cache.set("todo-service:seeded", "ready");
+  } else if (command === "verify") {
+    if ((await db.query("SELECT * FROM service_todos WHERE id LIKE 'seed-%'")).rowCount !== 3 || await cache.get("todo-service:seeded") !== "ready") throw new Error("Test fixtures not initialized");
+  } else throw new Error("Expected migrate, seed or verify");
+  console.log(`${command} complete`);
+} finally { await db.end(); await cache.quit(); }
