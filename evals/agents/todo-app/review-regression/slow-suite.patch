--- /dev/null
+++ b/vitest.ui.config.ts
@@ -0,0 +1,10 @@
+import { defineConfig } from "vitest/config";
+
+// The app's tests (src/), separate from the server's: they run against a simulated
+// slow network, so they take a while.
+export default defineConfig({
+  test: {
+    include: ["src/**/*.test.ts"],
+    testTimeout: 60_000,
+  },
+});
