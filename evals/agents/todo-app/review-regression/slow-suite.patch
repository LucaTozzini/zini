diff --git a/src/api.test.ts b/src/api.test.ts
new file mode 100644
index 0000000..b2ceae5
--- /dev/null
+++ b/src/api.test.ts
@@ -0,0 +1,57 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { addTodo, deleteTodo, fetchTodos, setDone } from "./api";
+
+// The app's API client against a simulated slow network: every response arrives after
+// LATENCY, like the production connection the app has to cope with.
+const LATENCY = 15_000;
+
+const respond = (status: number, body?: unknown) =>
+  vi.fn(
+    () =>
+      new Promise<Response>((resolve) =>
+        setTimeout(
+          () => resolve(new Response(body === undefined ? null : JSON.stringify(body), { status })),
+          LATENCY,
+        ),
+      ),
+  );
+
+const todo = { id: "a", title: "Buy milk", done: false, createdAt: "2026-01-01T00:00:00.000Z" };
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe("the API client on a slow network", () => {
+  it("fetches the to-dos", async () => {
+    vi.stubGlobal("fetch", respond(200, [todo]));
+    expect(await fetchTodos()).toEqual([todo]);
+  });
+
+  it("adds a to-do", async () => {
+    const fetch = respond(201, todo);
+    vi.stubGlobal("fetch", fetch);
+    expect(await addTodo("Buy milk")).toEqual(todo);
+    expect(fetch).toHaveBeenCalledWith("/api/todos", expect.objectContaining({ method: "POST" }));
+  });
+
+  it("ticks a to-do", async () => {
+    const fetch = respond(200, { ...todo, done: true });
+    vi.stubGlobal("fetch", fetch);
+    expect((await setDone("a", true)).done).toBe(true);
+    expect(fetch).toHaveBeenCalledWith("/api/todos/a", expect.objectContaining({ method: "PATCH" }));
+  });
+
+  it("deletes a to-do", async () => {
+    vi.stubGlobal("fetch", respond(204));
+    await expect(deleteTodo("a")).resolves.toBeUndefined();
+  });
+
+  it("reports the server's error", async () => {
+    vi.stubGlobal("fetch", respond(404, { error: "No such to-do" }));
+    await expect(setDone("missing", true)).rejects.toThrow("No such to-do");
+  });
+
+  it("reports a failure without an error message", async () => {
+    vi.stubGlobal("fetch", respond(500));
+    await expect(fetchTodos()).rejects.toThrow("Request failed (500)");
+  });
+});
diff --git a/vitest.ui.config.ts b/vitest.ui.config.ts
new file mode 100644
